{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "new.hello/mcp",
  "title": "hello.new",
  "description": "Upload links, Markdown pages, webhook URLs and websites for AI agents. No account needed.",
  "version": "1.0.1",
  "websiteUrl": "https://hello.new",
  "repository": {
    "url": "https://github.com/hellodotnew/hello",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://hello.new/brand/icon.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.hello.new/mcp",
      "headers": [
        {
          "name": "X-Hello-Client",
          "description": "Names the directory the install came from. Fixed, not a credential.",
          "value": "mcp-registry"
        }
      ]
    }
  ]
}
